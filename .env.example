# Example environment for the local demo (deploy/compose.yaml).
# All values are fake, local-only credentials. Copy to .env and adjust.

# PostgreSQL major version used by docker compose (14, 15, 16, 17, 18).
LOCKLENS_PG_VERSION=17
# Host port published on 127.0.0.1.
LOCKLENS_PG_PORT=55432

# Connection used by the locklens CLI (read-only observer role).
LOCKLENS_DSN=postgres://locklens_observer:observer-pw@127.0.0.1:55432/locklens_demo?sslmode=disable

# Connection used by the demo orchestrator to create lock contention.
LOCKLENS_DEMO_DSN=postgres://demo_app:demo-app-pw@127.0.0.1:55432/locklens_demo?sslmode=disable
