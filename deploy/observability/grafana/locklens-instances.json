      "title": "Open incidents",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(locklens_incidents_open{environment=~\"$environment\",target=~\"$target\"}) or vector(0)",
          "datasource": {
            "type": "prometheus",
