# Settings of `make up` (deploy/compose.yaml). `make up` writes deploy/.env
# with random values on the first run; copy this file instead to choose them.
# deploy/.env is ignored by git. Keep LOCKLENS_MASTER_KEY: it encrypts the
# stored connection strings, and a new key makes them unreadable.

# Password of LockLens' own monitoring store (the bundled PostgreSQL).
LOCKLENS_STORE_PASSWORD=
# 32 random bytes, base64: openssl rand -base64 32
LOCKLENS_MASTER_KEY=
# The environment administrator (12–72 characters). Change it here and run
# `make up` again to reset a forgotten password.
LOCKLENS_ADMIN_USER=admin
LOCKLENS_ADMIN_PASSWORD=
# true behind an HTTPS proxy.
LOCKLENS_COOKIE_SECURE=false
# Host port of the UI (bound to 127.0.0.1).
LOCKLENS_HTTP_PORT=8080
